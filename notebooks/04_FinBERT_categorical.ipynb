        "train_dataset = sentiment_text(x_train, y_train, tokenizer)\n",
        "test_dataset  = sentiment_text(x_test, y_test, tokenizer)\n",
        "val_dataset  = sentiment_text(x_val, y_val, tokenizer)"
      ]
